# Copy this file to .env.local and update values as needed

# Development Mode: Bypass authentication and use in-memory storage
BYPASS_AUTH=true
NEXT_PUBLIC_BYPASS_AUTH=true

# Note: When using bypass mode, you don't need to configure these:
# DATABASE_URL=postgresql://instrument:instrument@localhost:5432/instrument_checkout
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=your-secret-key-here
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TEK_SSO_SECRET=tek-internal-sso-2024
