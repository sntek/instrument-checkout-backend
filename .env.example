# Database
DATABASE_URL=postgresql://instrument:instrument@localhost:5432/instrument_checkout

# Better Auth
BETTER_AUTH_URL=http://localhost:3030
BETTER_AUTH_SECRET=your-secret-key-here

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tektronix SSO
TEK_SSO_SECRET=tek-internal-sso-2024

# Development: Bypass authentication (no Docker required)
# Set to 'true' to skip login screen and use in-memory storage in development
BYPASS_AUTH=false
NEXT_PUBLIC_BYPASS_AUTH=false
