# Copy to /etc/scope-checkin.env and reference it from the .service unit with:
#   EnvironmentFile=/etc/scope-checkin.env
CHECKIN_URL=http://lanthanum.global.tektronix.net:3030/api/instruments/checkin
SCOPE_NAME=MSO46B-Q000024
SCOPE_IFACE=eth0
SCOPE_TOKEN=
SCOPE_OS=Linux
# Team slug (e.g. rocket-lab). Required only to auto-register a brand-new
# instrument on first check-in; leave blank once it's registered.
SCOPE_TEAM=rocket-lab
